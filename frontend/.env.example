# PolyOne Frontend Environment Variables
# Copy this file to .env.local and fill in your actual values

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:5000

# Smart Contract Addresses
NEXT_PUBLIC_CHAIN_FACTORY_ADDRESS=
NEXT_PUBLIC_CHAIN_REGISTRY_ADDRESS=
NEXT_PUBLIC_VALIDATOR_REGISTRY_ADDRESS=
NEXT_PUBLIC_BRIDGE_ADDRESS=
NEXT_PUBLIC_BILLING_ADDRESS=

# Default Network
NEXT_PUBLIC_DEFAULT_NETWORK=polygonAmoy

# WalletConnect (Optional)
NEXT_PUBLIC_WALLETCONNECT_PROJECT_ID=

# PolygonScan API Key (Optional - for contract verification)
NEXT_PUBLIC_POLYGONSCAN_API_KEY=
